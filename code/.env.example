DEMO_MODE=false
MONGODB_URI=mongodb://localhost:27017/snapreels

# Premium media delivery (server-only; never expose the token key to clients).
BUNNY_CDN_HOST=<EPYVRA_PULL_ZONE_HOSTNAME>
BUNNY_CDN_TOKEN_KEY=<AT_LEAST_32_RANDOM_CHARACTERS>
PREMIUM_MEDIA_TOKEN_TTL_SECONDS=300
# Default is true. Keep enabled unless a documented mobile-network policy requires otherwise.
PREMIUM_MEDIA_BIND_IP=true
