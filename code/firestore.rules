
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      // Profiles, balances, VIP state and referral state are server-authoritative.
      allow create, update, delete: if false;
      
      match /favorites/{seriesId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
      
      match /history/{seriesId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
      
      match /unlockedEpisodes/{episodeId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow write: if false;
      }
      
      match /coinTransactions/{transactionId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow write: if false;
      }
      
      match /adWatches/{dateId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow write: if false;
      }
    }
    
    match /series/{seriesId} {
      allow read: if true;
      allow write: if false;
    }
    
    match /episodes/{episodeId} {
      allow read: if true;
      allow write: if false;
    }
    
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if false;
    }
    
    match /pages/{pageId} {
      allow read: if true;
      allow write: if false;
    }
    
    match /contacts/{contactId} {
      allow create: if true;
      allow read, update, delete: if false;
    }
    
    match /purchases/{purchaseId} {
      allow read, write: if false;
    }
    
    match /settings/{settingId} {
      // Mongo-backed APIs expose an explicit redacted public settings contract.
      allow read, write: if false;
    }
    
    match /ads/{adId} {
      allow read: if true;
      allow write: if false;
    }
    
    match /reports/{reportId} {
      allow create: if request.auth != null;
      allow read: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
